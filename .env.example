# ─────────────────────────────────────────────────────────────────────────
#  ZJAV_ CMS — premenné prostredia
#  Skopíruj do .env a vyplň. Do gitu .env nepatrí.
# ─────────────────────────────────────────────────────────────────────────

# ── Databáza ─────────────────────────────────────────────────────────────
# Lokálna vývojová databáza. NIKDY ju nesmeruj na produkčnú: jeden `next dev`
# proti produkčnej DB do nej zapíše dev-push záznam, ktorý potom zablokuje
# každý ďalší deploy na interaktívnej otázke, ktorú serverless boot nemá ako
# zodpovedať. Schému meň výhradne cez `npm run payload:migrate:create`.
DATABASE_URI=postgres://hub:hub@127.0.0.1:5432/hub

# Na Verceli ju vloží integrácia Neon / Vercel Postgres ako DATABASE_URL
# alebo POSTGRES_URL — config si vyberie prvú, ktorá existuje.
# DATABASE_URL=

# ── Bezpečnosť ───────────────────────────────────────────────────────────
# Dlhý náhodný reťazec, podpisujú sa ním prihlasovacie tokeny.
# Vygeneruj:  openssl rand -hex 32
PAYLOAD_SECRET=

# Verejná adresa hubu. Bez nej nefungujú absolútne odkazy v e-mailoch
# (obnova hesla, pozvánky) ani náhľady.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Produkcia: NEXT_PUBLIC_SERVER_URL=https://cms.zjav.sk

# ── Úložisko súborov ─────────────────────────────────────────────────────
# Bez tokenu sa súbory ukladajú na disk do ./media (funguje len lokálne,
# serverless disk je pri každom štarte prázdny). V produkcii povinné.
# BLOB_READ_WRITE_TOKEN=

# ── E-maily ──────────────────────────────────────────────────────────────
# Obnova hesla, pozvánky používateľov, upozornenia na odoslané formuláre.
# Bez kľúča Payload píše e-maily len do logu a nič sa neodošle.
# RESEND_API_KEY=
# EMAIL_FROM=ZJAV_ CMS <cms@zjav.sk>

# ── Cron ─────────────────────────────────────────────────────────────────
# Chráni /api/uloha/fronta (naplánované zverejnenie obsahu). Keď je
# nastavený, endpoint odmietne požiadavku bez tohto bearer tokenu.
# Vercel Cron ho posiela automaticky.
# CRON_SECRET=

# ── Automatické nasadenie webu ───────────────────────────────────────────
# Keď sú vyplnené, projekt so zapnutým „Založiť web z predvolenej šablóny"
# si pri uložení sám vyrobí repozitár zo šablóny, projekt na Verceli a spustí
# prvé nasadenie. Bez nich je mechanizmus vypnutý a projekt sa založí ako
# predtým — token, ktorý smie zakladať repozitáre, tu nemá ležať „pre istotu".
#
# GITHUB_TOKEN: personal access token s právom vytvárať repozitáre
#   (classic: repo; fine-grained: Administration → Read and write).
# SABLONA_REPO: repozitár označený na GitHube ako „Template repository".
#   Vyrobíš ho z priečinka sablona/ v tomto repozitári.
# GITHUB_OWNER: kam sa nové repozitáre zakladajú. Prázdne = vlastník šablóny.
# VERCEL_TOKEN / VERCEL_TEAM_ID: z vercel.com/account/tokens a nastavení tímu.
# GITHUB_TOKEN=
# SABLONA_REPO=kubbkoz/zjav-web
# GITHUB_OWNER=kubbkoz
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# ── Prvé spustenie ───────────────────────────────────────────────────────
# Keď je databáza prázdna, tieto dve premenné založia prvého master
# používateľa. Po prvom prihlásení ich pokojne zmaž.
# HUB_ADMIN_EMAIL=ty@zjav.sk
# HUB_ADMIN_PASSWORD=
