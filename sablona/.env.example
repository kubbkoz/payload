# ─────────────────────────────────────────────────────────────────────────
#  Web napojený na ZJAV CMS
#  Skopíruj do .env.local a vyplň. Web nemá vlastnú databázu — všetok obsah
#  ťahá z hubu cez tieto tri premenné.
# ─────────────────────────────────────────────────────────────────────────

# Kód projektu z administrácie (Systém → Projekty → Kód projektu).
# Toto je jediná premenná, ktorá sa medzi webmi naozaj líši.
HUB_PROJEKT=

# Adresa hubu. Meniť len pri lokálnom vývoji proti vlastnej inštancii.
HUB_URL=https://cms.zjav.sk

# API kľúč (Systém → API kľúče). Povinný len vtedy, keď má projekt vypnuté
# „obsah dostupný bez kľúča". Web ho drží na serveri a do prehliadača sa
# nikdy nedostane.
# HUB_API_KEY=

# Tajomstvo, ktorým hub podpisuje oznámenie o zmene obsahu. Musí sedieť
# s poľom „Tajomstvo pre prepláchnutie" pri projekte. Bez neho endpoint
# /api/revalidate odmietne každú požiadavku.
# HUB_SECRET=

# Verejná adresa tohto webu. Používa sa v sitemape a v absolútnych odkazoch.
# Na Verceli sa dopočíta sama, vyplň len pri vlastnej doméne.
# NEXT_PUBLIC_WEB_URL=https://priklad.sk
